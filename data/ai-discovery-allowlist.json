  "schema_version": 1,
  "name": "Scout v1 allowlist",
  "owner": "Gavin",
  "approved": "2026-11-06",
  "_comment": "Curated source policy for the AI discovery lane. v1 does not crawl the web and does not read an X firehose. bioRxiv, chemRxiv, and X are listed so later curation stays inside this list. fetch_in_v1 is false for every source except the optional arXiv API query.",
  "arxiv": {
    "fetch_in_v1": true,
    "fetch_note": "Worker /ai-discovery may query export.arxiv.org only with the categories below, and only when a search string is present. All arXiv items are preprints and keep the lane disclaimer.",
    "categories": [
      "cs.LG",
      "cs.AI",
      "stat.ML",
      "q-bio.BM",
      "q-bio.QM",
      "physics.chem-ph",
      "cond-mat.mtrl-sci",
      "physics.comp-ph"
    ],
    "conditional": [
      {
        "category": "cs.CL",
        "when": "science-relevant"
      }
    ]
  },
  "preprint_servers": [
    {
      "id": "biorxiv",
      "filter": "AI/ML methods",
      "fetch_in_v1": false
    },
    {
      "id": "chemrxiv",
      "filter": "AI/ML methods",
      "fetch_in_v1": false
    }
